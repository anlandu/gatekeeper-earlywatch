{
  "properties": {
    "displayName": "EarlyWatch: ManualSecretGuard - flag manual production Helm releases",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "description": "Flags a Helm release object (Secret of type helm.sh/release.v1, or any object named sh.helm.release.v1.* or labelled owner=helm, covering the secret and configmap storage backends) created by a caller that is not a system/automation identity or a JIT break-glass caller. Proxy for unapproved manual Helm installs.",
    "metadata": { "category": "Kubernetes" },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": { "displayName": "Effect", "description": "audit | deny | disabled" },
        "allowedValues": ["audit", "deny", "disabled"],
        "defaultValue": "audit"
      },
      "warn": {
        "type": "Boolean",
        "metadata": { "displayName": "Warn", "description": "Emit a warning instead of blocking" },
        "defaultValue": true
      },
      "excludedNamespaces": {
        "type": "Array",
        "metadata": { "displayName": "Namespaces to exclude" },
        "defaultValue": ["kube-system", "gatekeeper-system", "azure-arc", "azure-extensions-usage-system"]
      },
      "namespaces": {
        "type": "Array",
        "metadata": { "displayName": "Namespaces to include (empty = all)" },
        "defaultValue": []
      },
      "systemUserPrefixes": {
        "type": "Array",
        "metadata": { "displayName": "Username prefixes treated as system/automation" },
        "defaultValue": ["system:serviceaccount:"]
      },
      "systemUsers": {
        "type": "Array",
        "metadata": { "displayName": "Exact usernames treated as system/automation" },
        "defaultValue": ["aksService", "acsService"]
      },
      "helmReleaseNamePrefix": {
        "type": "String",
        "metadata": { "displayName": "Helm release object name prefix" },
        "defaultValue": "sh.helm.release.v1."
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "in": [
          "Microsoft.ContainerService/managedClusters",
          "Microsoft.Kubernetes/connectedClusters",
          "AKS Engine"
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "warn": "[parameters('warn')]",
          "templateInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          },
          "apiGroups": [""],
          "kinds": ["Secret", "ConfigMap"],
          "namespaces": "[parameters('namespaces')]",
          "excludedNamespaces": "[parameters('excludedNamespaces')]",
          "values": {
            "breakglassGroup": "[if(contains(subscription().tags, 'breakglassGuid'), subscription().tags['breakglassGuid'], 'd215e208-8f6f-4c64-af87-534f51499029')]",
            "systemUserPrefixes": "[parameters('systemUserPrefixes')]",
            "systemUsers": "[parameters('systemUsers')]",
            "helmReleaseNamePrefix": "[parameters('helmReleaseNamePrefix')]"
          }
        }
      }
    }
  }
}
