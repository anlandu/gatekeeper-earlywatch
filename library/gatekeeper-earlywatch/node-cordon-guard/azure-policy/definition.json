{
  "properties": {
    "displayName": "EarlyWatch: NodeCordonGuard - flag unjustified node cordons",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "description": "Flags a Ready Node cordoned (spec.unschedulable=true) by a caller that is not a system/automation identity or a JIT break-glass caller. Greenfield/admission oriented (relies on request userInfo). Azure Policy has no warn effect; audit is the non-blocking default.",
    "metadata": { "category": "Kubernetes" },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": { "displayName": "Effect", "description": "audit | deny | disabled" },
        "allowedValues": ["audit", "deny", "disabled"],
        "defaultValue": "audit"
      },
      "warn": {
        "type": "Boolean",
        "metadata": { "displayName": "Warn", "description": "Emit a warning instead of blocking" },
        "defaultValue": true
      },
      "systemUserPrefixes": {
        "type": "Array",
        "metadata": { "displayName": "Username prefixes treated as system/automation" },
        "defaultValue": ["system:serviceaccount:", "system:node:"]
      },
      "systemUsers": {
        "type": "Array",
        "metadata": { "displayName": "Exact usernames treated as system/automation" },
        "defaultValue": ["aksService", "acsService", "nodeclient"]
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "in": [
          "Microsoft.ContainerService/managedClusters",
          "Microsoft.Kubernetes/connectedClusters",
          "AKS Engine"
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "warn": "[parameters('warn')]",
          "templateInfo": {
            "sourceType": "PublicURL",
            "url": "https://raw.githubusercontent.com/anlandu/gatekeeper-earlywatch/refs/heads/main/library/gatekeeper-earlywatch/node-cordon-guard/template.yaml"
          },
          "apiGroups": [""],
          "kinds": ["Node"],
          "values": {
            "breakglassGroup": "[if(contains(subscription().tags, 'breakglassGuid'), subscription().tags['breakglassGuid'], 'tag-missing-on-subscription')]",
            "systemUserPrefixes": "[parameters('systemUserPrefixes')]",
            "systemUsers": "[parameters('systemUsers')]"
          }
        }
      }
    }
  }
}
